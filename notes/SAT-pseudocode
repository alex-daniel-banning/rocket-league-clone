function checkCollision(boxA, boxB):
    // Extract axes from both boxes
    axesA = [boxA.right, boxA.up, boxA.forward]
    axesB = [boxB.right, boxB.up, boxB.forward]
    
    // Test face normals of Box A (3 axes)
    for axis in axesA:
        if !testAxis(axis, boxA, boxB):
            return false
    
    // Test face normals of Box B (3 axes)
    for axis in axesB:
        if !testAxis(axis, boxA, boxB):
            return false
    
    // Test edge cross products (9 axes)
    for edgeA in axesA:
        for edgeB in axesB:
            axis = cross(edgeA, edgeB)
            if length(axis) < epsilon:  // parallel edges
                continue
            axis = normalize(axis)
            if !testAxis(axis, boxA, boxB):
                return false
    
    // TODO penetration correction
    return true  // All axes overlap


function testAxis(axis, boxA, boxB):
    // Project box centers onto axis
    projA = dot(boxA.center, axis)
    projB = dot(boxB.center, axis)
    
    // Calculate extents (half-widths of projections)
    rA = abs(dot(boxA.right, axis)) * boxA.halfWidth +
         abs(dot(boxA.up, axis)) * boxA.halfHeight +
         abs(dot(boxA.forward, axis)) * boxA.halfDepth
    
    rB = abs(dot(boxB.right, axis)) * boxB.halfWidth +
         abs(dot(boxB.up, axis)) * boxB.halfHeight +
         abs(dot(boxB.forward, axis)) * boxB.halfDepth
    
    // Check overlap
    distance = abs(projA - projB)
    return distance <= (rA + rB)
