mkdir .githooks

Create .githooks/pre-commit:
########################################################################
#!/bin/bash
# Shared pre-commit hook: build and run tests

if [[ "$(git log -1 --pretty=%B)" == *"[WIP]"* ]]; then
    echo "WIP commit detected. Skipping tests."
    exit 0
fi

# Build tests
echo "Building tests..."
cmake --build build || { echo "Build failed! Commit aborted."; exit 1; }

# Run tests
echo "Running tests..."
./build/tests || { echo "Tests failed! Commit aborted."; exit 1; }

# Optional: message for bypass
echo "All tests passed. Proceeding with commit."
exit 0
########################################################################

chmod +x .githooks/pre-commit

# Configure Git to use .githooks
git config core.hooksPath .githooks
